{
  "name": "AlpineCraft",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/alpinecraft",
  "shutdownAction": "stopCompose",
  "forwardPorts": [3000, 80, 3306, 8080],
  "portsAttributes": {
    "80": {
      "label": "Nested sites (Apache: / + /monvino + /api-php)",
      "onAutoForward": "notify"
    },
    "3000": {
      "label": "React Mon Vino (npm start → /monvino/)",
      "onAutoForward": "notify"
    },
    "8080": {
      "label": "Portfolio live (trunk serve)"
    },
    "3306": {
      "label": "MariaDB"
    }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "bash .devcontainer/post-start.sh",
  "remoteEnv": {
    "BROWSER": "none",
    "HOST": "0.0.0.0",
    "WDS_SOCKET_PORT": "0",
    "CHOKIDAR_USEPOLLING": "true",
    "WATCHPACK_POLLING": "true",
    "DB_HOST": "db",
    "DB_NAME": "pw2",
    "DB_USER": "monvino"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "bmewburn.vscode-intelephense-client",
        "xdebug.php-debug"
      ]
    }
  }
}
