# Copy to deploy.env (gitignored) and edit. No passwords or private keys here.
# Auth uses your local SSH agent / ~/.ssh keys only:
#   ssh-keygen -t ed25519
#   ssh-copy-id DEPLOY_USER@DEPLOY_HOST

DEPLOY_HOST=192.168.0.105
DEPLOY_USER=youruser
DEPLOY_PORT=22

# Paths on the Apache server
DEPLOY_PORTFOLIO_PATH=/var/www/html/alpinecraft
DEPLOY_MONVINO_PATH=/var/www/html/monvino
